#!/bin/sh
# Pre-push 钩子：当本次推送包含 frontend/ 改动时，执行 lint 与 build 检查
# 与 CI (.github/workflows/ci.yml) 的 Frontend Lint & Build Check 保持一致

z40=0000000000000000000000000000000000000000
changed=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue
  if git diff --name-only "$local_sha" --not --remotes 2>/dev/null | grep -q '^frontend/'; then
    changed=1
  fi
done

if [ "$changed" -eq 0 ]; then
  exit 0
fi

cd frontend || exit 1

if [ ! -d node_modules ]; then
  echo "✖ pre-push: frontend/node_modules 不存在，请先执行 npm ci" >&2
  exit 1
fi

echo "▶ pre-push: 运行前端 lint ..."
if ! npm run lint; then
  echo "✖ pre-push: lint 未通过，推送已取消（可加 --no-verify 跳过）" >&2
  exit 1
fi

echo "▶ pre-push: 运行前端 build ..."
if ! npm run build; then
  echo "✖ pre-push: build 未通过，推送已取消（可加 --no-verify 跳过）" >&2
  exit 1
fi

echo "✔ pre-push: 前端检查通过"
exit 0
